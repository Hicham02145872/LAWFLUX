# Développement local uniquement. Copier ce fichier en .env et choisir des mots de passe.
POSTGRES_ADMIN_PASSWORD=change-me-admin-local
IDENTITY_DB_PASSWORD=change-me-identity-local
CASES_DB_PASSWORD=change-me-cases-local
DOCUMENTS_DB_PASSWORD=change-me-documents-local
BILLING_DB_PASSWORD=change-me-billing-local
NOTIFICATIONS_DB_PASSWORD=change-me-notifications-local
RABBITMQ_USER=lawflux
RABBITMQ_PASSWORD=change-me-rabbit-local
# Sonde technique facultative, sans données métier, réservée au réseau local.
SCAFFOLD_EVENTS_ENABLED=false
